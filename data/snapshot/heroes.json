[{"id":6,"name":"Abrams","className":"hero_atlas","bulletGrowth":0.1,"spiritGrowth":1.1,"playstyle":"Abrams has the bulk and sustain to lead from the front, often running into the middle of his foes and watching them scatter. If his enemies waste their fire on him, his backline teammates can lay out damage with impunity.","signatures":["citadel_ability_bull_heal","citadel_ability_bull_charge","citadel_ability_passive_beefy","citadel_ability_bull_leap"],"smallImage":"heroes/6-small.webp","cardImage":"heroes/6-card.webp"},{"id":77,"name":"Apollo","className":"hero_fencer","bulletGrowth":0.825,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_fencer_throwblade","ability_fencer_riposte","ability_fencer_lunge","ability_fencer_ultimate"],"smallImage":"heroes/77-small.webp","cardImage":"heroes/77-card.webp"},{"id":88,"name":"Baba","className":"hero_baba","bulletGrowth":0.41,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_baba_bubbling_brew","ability_baba_bench_run","ability_baba_hexing_brew","ability_baba_ultimate_2"],"smallImage":"heroes/88-small.webp","cardImage":"heroes/88-card.webp"},{"id":15,"name":"Bebop","className":"hero_bebop","bulletGrowth":0.115,"spiritGrowth":1.1,"playstyle":"Bebop can string together his abilities in many different ways. Disrupting enemy positions, saving an ally or dealing bursts of damage. When the situation doesn't require subtlety his giant laser still solves many problems.","signatures":["citadel_ability_uppercut","citadel_ability_sticky_bomb","citadel_ability_hook","citadel_ability_bebop_laser_beam"],"smallImage":"heroes/15-small.webp","cardImage":"heroes/15-card.webp"},{"id":72,"name":"Billy","className":"hero_punkgoat","bulletGrowth":0.127,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_punkgoat_ult","ability_punkgoat_goatflip","ability_punkgoat_blasted","ability_punkgoat_tether"],"smallImage":"heroes/72-small.webp","cardImage":"heroes/72-card.webp"},{"id":16,"name":"Calico","className":"hero_nano","bulletGrowth":0.043,"spiritGrowth":1.1,"playstyle":"Calico uses the shadows to her advantage, weaving in and out of combat to hunt down her enemies one by one.","signatures":["ability_nano_clustergrenade","ability_nano_dash","ability_nano_catform","ability_nano_shadow_pulse"],"smallImage":"heroes/16-small.webp","cardImage":"heroes/16-card.webp"},{"id":81,"name":"Celeste","className":"hero_unicorn","bulletGrowth":0.82,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_unicorn_radiantblast","ability_unicorn_prismaticguard","ability_unicorn_luminousstrike","ability_unicorn_dazzlingorb"],"smallImage":"heroes/81-small.webp","cardImage":"heroes/81-card.webp"},{"id":78,"name":"Deadman Danny","className":"hero_deadpack","bulletGrowth":0.42,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_deadpack_chargeblast","ability_deadpack_rocketeer","ability_deadpack_flamethrower","ability_deadpack_ultimate"],"smallImage":"heroes/78-small.webp","cardImage":"heroes/78-card.webp"},{"id":64,"name":"Drifter","className":"hero_drifter","bulletGrowth":0.49,"spiritGrowth":1.1,"playstyle":"","signatures":["drifter_blood_blast","drifter_shadow_mark","ability_drifter_hunger","drifter_darkness"],"smallImage":"heroes/64-small.webp","cardImage":"heroes/64-card.webp"},{"id":11,"name":"Dynamo","className":"hero_dynamo","bulletGrowth":0.5,"spiritGrowth":1.1,"playstyle":"Dynamo keeps himself and his allies healthy while waiting for his moment. Few things can warp a team fight more than a well-coordinated use of Singularity.","signatures":["citadel_ability_stomp","citadel_ability_void_sphere","citadel_ability_nikuman","citadel_ability_self_vacuum"],"smallImage":"heroes/11-small.webp","cardImage":"heroes/11-card.webp"},{"id":76,"name":"Graves","className":"hero_necro","bulletGrowth":0.052,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_necro_hauntingskull","ability_necro_zombiewall","ability_necro_fear","ability_necro_gravestone"],"smallImage":"heroes/76-small.webp","cardImage":"heroes/76-card.webp"},{"id":17,"name":"Grey Talon","className":"hero_orion","bulletGrowth":0.85,"spiritGrowth":1.6,"playstyle":"A cunning predator, Grey Talon uses a combination of deadly accuracy, traps, and clever positioning to bring down the toughest of opponents.","signatures":["ability_charged_shot","ability_power_jump","ability_immobilize_trap","ability_guided_arrow"],"smallImage":"heroes/17-small.webp","cardImage":"heroes/17-card.webp"},{"id":13,"name":"Haze","className":"hero_haze","bulletGrowth":0.143,"spiritGrowth":0.5,"playstyle":"When Haze fixates on a target she can hold her own in a firefight. She prefers to create one sided exchanges, avoiding damage then picking off unsuspecting targets up close.","signatures":["ability_sleep_dagger","ability_smoke_bomb","ability_stacking_damage","ability_bullet_flurry"],"smallImage":"heroes/13-small.webp","cardImage":"heroes/13-card.webp"},{"id":14,"name":"Holliday","className":"hero_astro","bulletGrowth":1.144,"spiritGrowth":1.1,"playstyle":"Holliday depends on her skills as a crack shot, shooting things she's bounced into the air. With good aim she can lay out heavy damage. Her movement skills let her isolate her enemies or beat a hasty retreat.","signatures":["ability_explosive_barrel","ability_bounce_pad","ability_crackshot","ability_gravity_lasso"],"smallImage":"heroes/14-small.webp","cardImage":"heroes/14-card.webp"},{"id":1,"name":"Infernus","className":"hero_inferno","bulletGrowth":0.088,"spiritGrowth":1.1,"playstyle":"Infernus has many ways to deal damage over time, burning foes before swooping in for the kill. Due to Infernus' blazing speed, his enemies won't be able to escape the flames.","signatures":["ability_incendiary_projectile","ability_flame_dash","ability_afterburn","ability_fire_bomb"],"smallImage":"heroes/1-small.webp","cardImage":"heroes/1-card.webp"},{"id":20,"name":"Ivy","className":"hero_tengu","bulletGrowth":0.08,"spiritGrowth":1.2,"playstyle":"Ivy has disruptive combat tricks that slow and stun enemies. She's most effective when linking up with an ally, empowering her and her ally's guns as well as sharing heals.","signatures":["citadel_ability_tengu_urn","citadel_ability_tangotether","citadel_ability_tengu_stone_form","citadel_ability_tengu_airlift"],"smallImage":"heroes/20-small.webp","cardImage":"heroes/20-card.webp"},{"id":12,"name":"Kelvin","className":"hero_kelvin","bulletGrowth":0.418,"spiritGrowth":1.3,"playstyle":"Timely heals and splitting a teamfight properly is the difference between an easy victory or a ruinous defeat. Gliding around slowing enemies gives Kelvin's team the maneuvering advantage to make this happen.","signatures":["ability_ice_grenade","ability_icepath","ability_icebeam","ability_ice_dome"],"smallImage":"heroes/12-small.webp","cardImage":"heroes/12-card.webp"},{"id":4,"name":"Lady Geist","className":"hero_ghost","bulletGrowth":1.0,"spiritGrowth":1.1,"playstyle":"Expending health to achieve devastating effects is the source of Lady Geist's power. When running low, she can drain the life out of her rivals.","signatures":["ability_blood_bomb","ability_life_drain","ability_blood_shards","ability_health_swap"],"smallImage":"heroes/4-small.webp","cardImage":"heroes/4-card.webp"},{"id":31,"name":"Lash","className":"hero_lash","bulletGrowth":0.31,"spiritGrowth":1.1,"playstyle":"Lash gives his enemies little room to breathe, either by flying in from long distances to initiate combat with unsuspecting enemies, or pursuing said enemies when they try to run.","signatures":["citadel_ability_lash_down_strike","citadel_ability_lash","ability_lash_flog","citadel_ability_lash_ultimate"],"smallImage":"heroes/31-small.webp","cardImage":"heroes/31-card.webp"},{"id":8,"name":"McGinnis","className":"hero_forge","bulletGrowth":0.171,"spiritGrowth":1.1,"playstyle":"Precise placement is everything for McGinnis, whether she's creating a killzone or splitting the enemy team. She can help keep her team running making them hard to dislodge when entrenched.","signatures":["citadel_ability_shieldedsentry","citadel_ability_mobile_resupply","citadel_ability_fissure_wall","citadel_ability_rocket_barrage"],"smallImage":"heroes/8-small.webp","cardImage":"heroes/8-card.webp"},{"id":63,"name":"Mina","className":"hero_vampirebat","bulletGrowth":0.275,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_vampirebat_steallife","ability_vampirebat_batblink","ability_vampirebat_lovebites","ability_vampirebat_batswarm"],"smallImage":"heroes/63-small.webp","cardImage":"heroes/63-card.webp"},{"id":52,"name":"Mirage","className":"hero_mirage","bulletGrowth":0.3,"spiritGrowth":1.1,"playstyle":"Mirage can envelop himself in a violent tornado to catch up to enemies and lift them up. His scarabs help him sustain against multiple enemies, and he's always ready to help an ally or punish an enemy anywhere.","signatures":["mirage_fire_beetles","mirage_tornado","mirage_sand_phantom","mirage_teleport"],"smallImage":"heroes/52-small.webp","cardImage":"heroes/52-card.webp"},{"id":18,"name":"Mo & Krill","className":"hero_krill","bulletGrowth":0.0881,"spiritGrowth":0.6,"playstyle":"By burrowing through the ground, Mo and Krill can get the drop on almost anyone; and once they get in close the results can be devastating.","signatures":["ability_intimidate","ability_burrow","ability_throw_sand","ability_ult_combo"],"smallImage":"heroes/18-small.webp","cardImage":"heroes/18-card.webp"},{"id":87,"name":"Nurse Harrow","className":"hero_nurse","bulletGrowth":0.37436,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_nurse_leech_therapy","ability_nurse_adrenaline_rush","ability_nurse_healing_needles","ability_nurse_fear"],"smallImage":"heroes/87-small.webp","cardImage":"heroes/87-card.webp"},{"id":67,"name":"Paige","className":"hero_bookworm","bulletGrowth":0.61,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_bookworm_dragonfire","ability_bookworm_knightbarrier","ability_bookworm_aoemagic","ability_bookworm_knightcharge"],"smallImage":"heroes/67-small.webp","cardImage":"heroes/67-card.webp"},{"id":10,"name":"Paradox","className":"hero_chrono","bulletGrowth":0.26,"spiritGrowth":1.1,"playstyle":"Manipulating time lets Paradox outpace an enemy in one on one combat. She thrives by subjecting her enemies to timely swaps into a waiting pulse grenade, her wall, or into the middle of her teammates.","signatures":["citadel_ability_chrono_pulse_grenade","citadel_ability_chrono_time_wall","citadel_ability_chrono_kinetic_carbine","citadel_ability_chrono_swap"],"smallImage":"heroes/10-small.webp","cardImage":"heroes/10-card.webp"},{"id":50,"name":"Pocket","className":"hero_synth","bulletGrowth":0.14,"spiritGrowth":1.1,"playstyle":"With a powerful shotgun and a thin frame, Pocket relies on their ability to briefly escape into a mystic suitcase and teleport via a flying cloak in order to survive close encounters.","signatures":["synth_barrage","synth_plasma_flux","synth_pulse","synth_affliction"],"smallImage":"heroes/50-small.webp","cardImage":"heroes/50-card.webp"},{"id":84,"name":"Rat King","className":"hero_ratking","bulletGrowth":0.144,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_ratking_scrap_grenade","ability_ratking_ratnibble","ability_ratking_ratarmor","ability_ratking_standard_bearer"],"smallImage":"heroes/84-small.webp","cardImage":"heroes/84-card.webp"},{"id":79,"name":"Rem","className":"hero_familiar","bulletGrowth":0.34,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_familiar_ability02","ability_familiar_attach","ability_familiar_helpinghands","ability_familiar_ability01"],"smallImage":"heroes/79-small.webp","cardImage":"heroes/79-card.webp"},{"id":2,"name":"Seven","className":"hero_gigawatt","bulletGrowth":0.24,"spiritGrowth":1.1,"playstyle":"Seven thrives in a skirmish waiting for the time to strike. Then he rolls into the fight like a storm and batters his enemies with a cascade of lightning.","signatures":["citadel_ability_lightning_ball","citadel_ability_static_charge","ability_power_surge","citadel_ability_storm_cloud"],"smallImage":"heroes/2-small.webp","cardImage":"heroes/2-card.webp"},{"id":19,"name":"Shiv","className":"hero_shiv","bulletGrowth":0.165,"spiritGrowth":1.1,"playstyle":"Shiv has zero interest in playing fair, which is why he relies on hit and run tactics to weaken enemies before he dives in for the kill.","signatures":["citadel_ability_shiv_dagger","citadel_ability_shiv_dash","citadel_ability_shiv_defer_damage","citadel_ability_shiv_killing_blow"],"smallImage":"heroes/19-small.webp","cardImage":"heroes/19-card.webp"},{"id":80,"name":"Silver","className":"hero_werewolf","bulletGrowth":0.117,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_werewolf_unloadgun","ability_werewolf_kickflip","ability_werewolf_netshot","ability_werewolf_transformation"],"smallImage":"heroes/80-small.webp","cardImage":"heroes/80-card.webp"},{"id":60,"name":"Sinclair","className":"hero_magician","bulletGrowth":0.55,"spiritGrowth":1.3,"playstyle":"With the help of their unwilling assistant, The Magnificent Sinclair can confuse enemies with curving hexes and rapid bolts.","signatures":["ability_magician_magicbolt","ability_magician_cloneturret","ability_magician_animalhexarea","ability_magician_copyult"],"smallImage":"heroes/60-small.webp","cardImage":"heroes/60-card.webp"},{"id":85,"name":"Solomon","className":"hero_chessmaster","bulletGrowth":0.4,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_chessmaster_throwbishop","ability_chessmaster_knightbuff","ability_chessmaster_forkpiece","ability_chessmaster_queen"],"smallImage":"heroes/85-small.webp","cardImage":"heroes/85-card.webp"},{"id":69,"name":"The Doorman","className":"hero_doorman","bulletGrowth":1.25,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_doorman_bomb","ability_doorman_doorway","ability_doorman_luggage_cart","ability_doorman_hotel"],"smallImage":"heroes/69-small.webp","cardImage":"heroes/69-card.webp"},{"id":65,"name":"Venator","className":"hero_priest","bulletGrowth":0.27,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_priest_flashbang","ability_priest_knockback","ability_priest_beartrap","ability_priest_weaponswap"],"smallImage":"heroes/65-small.webp","cardImage":"heroes/65-card.webp"},{"id":66,"name":"Victor","className":"hero_frank","bulletGrowth":0.26,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_frank_shocktarget2","ability_frank_selfzap","ability_frank_painaura","ability_frank_revive"],"smallImage":"heroes/66-small.webp","cardImage":"heroes/66-card.webp"},{"id":3,"name":"Vindicta","className":"hero_hornet","bulletGrowth":0.495,"spiritGrowth":1.1,"playstyle":"Vindicta has the mobility to engage at her leisure, picking at her prey and bleeding them out slowly. Injured enemies at any distance should fear being picked off when she is on the map.","signatures":["citadel_ability_hornet_chain","citadel_ability_hornet_leap","citadel_ability_hornet_sting","citadel_ability_hornet_snipe"],"smallImage":"heroes/3-small.webp","cardImage":"heroes/3-card.webp"},{"id":86,"name":"Violet","className":"hero_artist","bulletGrowth":0.55,"spiritGrowth":1.1,"playstyle":"","signatures":["ability_artist_homingbrush","ability_artist_rollingprojectile","ability_artist_tether","ability_artist_bamboogrove"],"smallImage":"heroes/86-small.webp","cardImage":"heroes/86-card.webp"},{"id":35,"name":"Viscous","className":"hero_viscous","bulletGrowth":0.36,"spiritGrowth":1.3,"playstyle":"Viscous vexes his opponents through clever evasion and strategic uses of healing, enabling him to withstand the most brutal of enemy attacks.","signatures":["viscous_goo_grenade","viscous_restorative_goo","viscous_telepunch","viscous_goo_bowling_ball"],"smallImage":"heroes/35-small.webp","cardImage":"heroes/35-card.webp"},{"id":58,"name":"Vyper","className":"hero_viper","bulletGrowth":0.178,"spiritGrowth":1.1,"playstyle":"With a powerful weapon (and deadly venom to match), Vyper can slither into the back of teams and assassinate high-priority targets in a storm of bullets.","signatures":["ability_viper_debuffdagger","ability_viper_venom","ability_viper_snakedash","ability_viper_petrifybola"],"smallImage":"heroes/58-small.webp","cardImage":"heroes/58-card.webp"},{"id":25,"name":"Warden","className":"hero_warden","bulletGrowth":0.25,"spiritGrowth":1.1,"playstyle":"Warden leads from the front, jumping into the fray and hindering his opponents' ability to fight effectively. But what Warden considers brave, others consider reckless, and if he's not careful he can easily find himself in over his head.","signatures":["ability_warden_crowd_control","ability_warden_high_alert","ability_warden_lock_down","ability_warden_riot_protocol"],"smallImage":"heroes/25-small.webp","cardImage":"heroes/25-card.webp"},{"id":7,"name":"Wraith","className":"hero_wraith","bulletGrowth":0.14,"spiritGrowth":1.1,"playstyle":"Excelling at one-on-one combat, Wraith isolates targets, eliminating them with ruthless efficiency. Then teleporting away before anyone can retaliate.","signatures":["citadel_ability_card_toss","citadel_ability_projectmind","citadel_ability_wraith_rapidfire","citadel_ability_psychic_lift"],"smallImage":"heroes/7-small.webp","cardImage":"heroes/7-card.webp"},{"id":27,"name":"Yamato","className":"hero_yamato","bulletGrowth":0.154,"spiritGrowth":1.1,"playstyle":"Yamato uses precise strikes to decimate her rivals. However, such damaging attacks often will leave her exposed, so she needs to make every shot count.","signatures":["citadel_ability_power_slash","citadel_ability_flying_strike","citadel_ability_healing_slash","citadel_ability_infinity_slash"],"smallImage":"heroes/27-small.webp","cardImage":"heroes/27-card.webp"}]